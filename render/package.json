{
  "name": "render",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "node spiel-render.js --bundle",
    "test": "node --test tests/einstellungen.test.cjs tests/silhouetten.test.mjs && node spiel-render.js --bundle && node tests/mobil-smoke.js && node tests/kamera-haus-mobil-smoke.cjs",
    "smoke:kamera-haus": "node spiel-render.js --bundle && node tests/kamera-haus-mobil-smoke.cjs",
    "smoke:panels": "node spiel-render.js --nur-panels",
    "smoke:karte": "node spiel-render.js --nur-karte",
    "smoke:voll": "node spiel-render.js",
    "smoke:start": "node spiel-render.js --nur-start",
    "smoke:spielende": "npm run build && node tests/spielende-smoke.cjs",
    "zeitung:bilder": "node tests/zeitung-bilder.cjs",
    "smoke:wettbewerber": "node spiel-render.js --nur-wettbewerber",
    "wettbewerb:beispiel": "node -e \"require('esbuild').buildSync({entryPoints:['../engine/scripts/wettbewerb-beispiel.ts'],bundle:true,platform:'node',outfile:'out/wettbewerb-beispiel.cjs'});require('./out/wettbewerb-beispiel.cjs')\"",
    "iphone": "node spiel-render.js --bundle && node dev-server.js",
    "moebel:pruefen": "node pruef-moebel.js",
    "moebel:kataloge": "node render-katalog.js moebel-sport && node render-katalog.js moebel-outlet && node render-katalog.js moebel-allgemein && node render-katalog.js moebel-reihen",
    "ladenbau:pruefen": "node pruef-ladenbau.js",
    "ladenbau:pruefen:teile": "node pruef-ladenbau.js --teile",
    "ladenbau:smoke": "node tests/ladenbau-smoke.cjs && node tests/outlet-ladenbau-smoke.cjs",
    "ladenbau:diagnose": "node render-katalog.js ladenplan-diagnose",
    "ladenbau:outlet:smoke": "node tests/outlet-ladenbau-smoke.cjs",
    "smoke:haus": "node spiel-render.js --nur-haus",
    "fingerabdruck:pruefen": "node pruef-fingerabdruck.js",
    "fingerabdruck:gegenprobe": "node tests/fingerabdruck-smoke.cjs",
    "test:einstellungen": "node --test tests/einstellungen.test.cjs",
    "bedienung:pruefen": "node pruef-bedienung.js",
    "smoke:werkzeuge": "node spiel-render.js --nur-werkzeuge",
    "jahreszeiten:pruefen": "node tests/jahreszeit.test.cjs",
    "symbol": "node symbol.js",
    "smoke:app": "node tests/app-pwa-smoke.cjs",
    "marktbeobachtung:bilder": "node tests/marktbeobachtung-bilder.cjs",
    "hauspins:pruefen": "node pruef-hauspins.js",
    "hausbesuch:laufwege:unit": "node tests/hausbesuch-navigation.cjs",
    "hausbesuch:laufwege": "node tests/hausbesuch-navigation.cjs && node tests/hausbesuch-laufwege.cjs"
  },
  "keywords": [],
